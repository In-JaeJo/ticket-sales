{
  "uid": "ticket-sales",
  "title": "ticket-sales",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    { "id": 1, "type": "stat", "title": "남은 재고", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "ticket_stock_remaining" }] },
    { "id": 2, "type": "stat", "title": "대기자", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "ticket_queue_waiting" }] },
    { "id": 3, "type": "stat", "title": "SSE 연결", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "ticket_sse_connections" }] },
    { "id": 4, "type": "stat", "title": "Outbox 미발행", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "ticket_outbox_unpublished" }] },
    { "id": 5, "type": "stat", "title": "DLQ 남은 메시지", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "(sum(ticket_dlq_published_total) or vector(0)) - (sum(ticket_dlq_replayed_total) or vector(0))" }] },
    { "id": 6, "type": "stat", "title": "결제 후 취소", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(ticket_orders_paid_after_cancel_total) or vector(0)" }] },

    { "id": 7, "type": "timeseries", "title": "주문 TPS (응답 코드별)", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{status}}",
        "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=\"/api/orders\",method=\"POST\"}[30s]))" }] },
    { "id": 8, "type": "timeseries", "title": "주문 응답 시간 p50 / p95 / p99", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/orders\"}[1m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/orders\"}[1m])))" },
        { "refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/orders\"}[1m])))" }] },

    { "id": 9, "type": "timeseries", "title": "Kafka 컨슈머 지연 (최대 lag)", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{client_id}}",
        "expr": "max by (client_id) (kafka_consumer_fetch_manager_records_lag_max)" }] },
    { "id": 10, "type": "timeseries", "title": "주문 상태", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{status}}", "expr": "ticket_orders" }] },

    { "id": 11, "type": "timeseries", "title": "DB 커넥션 풀", "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "사용 중", "expr": "sum(hikaricp_connections_active)" },
        { "refId": "B", "legendFormat": "대기", "expr": "sum(hikaricp_connections_pending)" },
        { "refId": "C", "legendFormat": "최대", "expr": "sum(hikaricp_connections_max)" }] },
    { "id": 12, "type": "timeseries", "title": "소비자가 건너뛴 메시지 (초당)", "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{reason}}",
        "expr": "sum by (reason) (rate(ticket_consumer_skipped_total[1m]))" }] },
    { "id": 13, "type": "timeseries", "title": "입장 수 · 낙관적 락 재시도 (초당)", "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "입장", "expr": "rate(ticket_queue_admitted_total[1m])" },
        { "refId": "B", "legendFormat": "낙관적 락 재시도", "expr": "rate(ticket_stock_optimistic_retry_total[1m])" }] }
  ]
}
